{
  "entities": {
    "ballot": {
      "title": "Ballot Record",
      "description": "Represents a member's authorization to vote.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "The member's full name." },
        "hasVoted": { "type": "boolean", "description": "Whether the ballot has been used." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp." },
        "votedAt": { "type": "string", "format": "date-time", "description": "Timestamp of the vote." }
      },
      "required": ["name", "hasVoted", "createdAt"]
    },
    "nominee": {
      "title": "Nominee",
      "description": "A candidate running for a specific position.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "position": { "type": "string" },
        "biography": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["name", "position"]
    },
    "vote": {
      "title": "Vote Record",
      "description": "An anonymized or linked vote record.",
      "type": "object",
      "properties": {
        "ballotNumber": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "selections": { 
          "type": "object",
          "description": "Map of position title to nominee ID or name."
        }
      },
      "required": ["ballotNumber", "timestamp", "selections"]
    },
    "revision": {
      "title": "Constitution Revision",
      "description": "A proposed amendment to the constitution or by-laws.",
      "type": "object",
      "properties": {
        "documentType": { "type": "string", "description": "Whether Constitution or By-laws" },
        "article": { "type": "string" },
        "section": { "type": "string" },
        "originalText": { "type": "string" },
        "proposedText": { "type": "string" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "submitterName": { "type": "string" }
      },
      "required": ["article", "section", "originalText", "proposedText", "submittedAt"]
    },
    "membership_application": {
      "title": "Membership Application",
      "description": "New member application data.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "firstName": { "type": "string" },
        "middleName": { "type": "string" },
        "lastName": { "type": "string" },
        "dateOfBirth": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "employment": { "type": "string" },
        "position": { "type": "string" },
        "degrees": { "type": "string" },
        "honors": { "type": "string" },
        "organizations": { "type": "string" },
        "priorKnowledge": { "type": "string" },
        "essay1": { "type": "string" },
        "essay2": { "type": "string" },
        "essay3": { "type": "string" },
        "essay4": { "type": "string" },
        "essay5": { "type": "string" },
        "isFraternityMember": { "type": "boolean" },
        "fraternityDetails": { "type": "string" },
        "hasAkaFamily": { "type": "boolean" },
        "akaFamilyDetails": { "type": "string" },
        "previousApplied": { "type": "boolean" },
        "previousAppliedDetails": { "type": "string" },
        "socialUrls": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "submitted"] },
        "lastSavedAt": { "type": "string", "format": "date-time" },
        "submittedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "firstName", "lastName", "status"]
    },
    "candidate_account": {
      "title": "Candidate Account",
      "description": "Prospective candidate account credentials and details stored in Firebase.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "name", "role"]
    },
    "portal_member": {
      "title": "Portal Member",
      "description": "Member directory and role records.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "first_name": { "type": "string" },
        "last_name": { "type": "string" },
        "role": { "type": "string" },
        "title": { "type": "string" },
        "intake_class": { "type": "string" },
        "financial_status": { "type": "string" },
        "industry": { "type": "string" }
      },
      "required": ["email", "name", "role"]
    },
    "user_password_override": {
      "title": "User Password Override",
      "description": "Persistent password override records across dev and prod environments.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "hash": { "type": "string" },
        "isFirstLogin": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "hash"]
    },
    "dean_nomination": {
      "title": "Dean Nomination",
      "description": "Intake Dean nomination record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "voter_email": { "type": "string" },
        "nominee_first_name": { "type": "string" },
        "nominee_last_name": { "type": "string" },
        "statement": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "is_dev": { "type": "boolean" }
      },
      "required": ["voter_email", "nominee_first_name", "nominee_last_name", "statement"]
    },
    "dean_vote": {
      "title": "Dean Vote",
      "description": "Intake Dean voting ballot record.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "voter_email": { "type": "string" },
        "nominee_name": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "is_dev": { "type": "boolean" }
      },
      "required": ["voter_email", "nominee_name"]
    }
  },
  "firestore": {
    "dean_nominations/{nominationId}": {
      "schema": "dean_nomination",
      "description": "Production Intake Dean nominations."
    },
    "dean_nominations_dev/{nominationId}": {
      "schema": "dean_nomination",
      "description": "Development Intake Dean nominations."
    },
    "dean_votes/{voteId}": {
      "schema": "dean_vote",
      "description": "Production Intake Dean votes."
    },
    "dean_votes_dev/{voteId}": {
      "schema": "dean_vote",
      "description": "Development Intake Dean votes."
    },
    "user_password_overrides/{overrideId}": {
      "schema": "user_password_override",
      "description": "User password overrides synchronized across dev and prod database instances."
    },
    "applications/{applicationId}": {
      "schema": "membership_application",
      "description": "Member applications."
    },
    "candidate_accounts/{accountId}": {
      "schema": "candidate_account",
      "description": "Candidate accounts and credential metadata."
    },
    "portal_members/{memberId}": {
      "schema": "portal_member",
      "description": "Member roster records."
    },
    "ballots/{ballotId}": {
      "schema": "ballot",
      "description": "Authorized ballot numbers."
    },
    "nominees/{nomineeId}": {
      "schema": "nominee",
      "description": "List of candidates."
    },
    "votes/{voteId}": {
      "schema": "vote",
      "description": "Cast votes."
    },
    "revisions/{revisionId}": {
      "schema": "revision",
      "description": "Proposed amendments to the constitution."
    }
  }
}
